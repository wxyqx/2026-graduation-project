# 数据库连接（本机示例，按需修改；把 your-password 换成你的 MySQL 密码）
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/ats?charset=utf8mb4
# JWT 密钥（务必换成随机值，可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=change-me-to-a-random-hex-string
TOKEN_EXPIRE_DAYS=7

# ===== 候选人端（v3.15）=====
# 默认密码：候选人账号开通、重置密码时使用
DEFAULT_CANDIDATE_PASSWORD=admin
# 候选人登录有效期（天）
PORTAL_TOKEN_EXPIRE_DAYS=30
# 短信验证码总开关：本期 false（接口不开放），接真实通道后再改 true
PORTAL_SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_SECONDS=60
# 同一候选人 24 小时最多投递次数
PORTAL_APPLY_DAILY_LIMIT=10
# 单个文件最大 MB / 单个候选人文件总量 MB
PORTAL_UPLOAD_MAX_MB=10
PORTAL_FILE_TOTAL_MB=50

# ===== 账号安全（v3.15）=====
# 是否允许 /api/auth/register 自助注册 HR；首个技术管理员用 scripts/create_user.py 创建
ALLOW_HR_REGISTER=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10
